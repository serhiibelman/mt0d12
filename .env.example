DEVICE="/dev/ttyACM0"
FC_DEVICE="/dev/serial0"
FC_BAUDRATE="115200"
# Tuned for the Pi 1 Model B+ (single core ARMv6, 512 MB).
# On a Pi 3 B+ or newer, 640x480 at 20 fps and 4 clients are comfortable.
CAMERA_ENABLED="true"
CAMERA_WIDTH="320"
CAMERA_HEIGHT="240"
CAMERA_FRAMERATE="10"
CAMERA_JPEG_QUALITY="75"
CAMERA_MAX_CLIENTS="2"
# auto | hardware | software - auto prefers the VideoCore JPEG encoder.
CAMERA_ENCODER="auto"
CAMERA_BUFFER_COUNT="2"

# AWS IoT Core. Leave IOT_ENDPOINT empty to run with no telemetry at all.
# Endpoint: AWS console -> IoT Core -> Settings -> Device data endpoint,
# or: aws iot describe-endpoint --endpoint-type iot:Data-ATS
IOT_ENDPOINT=""
IOT_THING_NAME="rover-01"
IOT_CLIENT_ID="rover-01"
TELEMETRY_TOPIC="rover/{thing}/telemetry"
# Device certificate and key from terraform (terraform/secrets/), plus the
# Amazon root CA - see docs/MQTT.md.
IOT_CERT_PATH="/home/pi/mt0d12/certs/device.pem.crt"
IOT_KEY_PATH="/home/pi/mt0d12/certs/private.pem.key"
IOT_ROOT_CA_PATH="/home/pi/mt0d12/certs/Amazon-root-CA-1.pem"
IOT_PORT="8883"
IOT_KEEP_ALIVE_SECONDS="30"
TELEMETRY_PUBLISH_TIMEOUT_SECONDS="5.0"
# Snapshots are sampled every INTERVAL and published only when something
# changed, plus one HEARTBEAT message so silence still means "gone".
TELEMETRY_INTERVAL_SECONDS="5.0"
TELEMETRY_HEARTBEAT_SECONDS="30.0"
# While parked, heartbeat this rarely instead. Changes still publish at once.
TELEMETRY_IDLE_HEARTBEAT_SECONDS="300.0"
# Offline spool. Messages are written here before they are sent and removed
# once the broker acknowledges them, so an outage delays telemetry instead of
# losing it. Set the path empty to switch spooling off.
TELEMETRY_SPOOL_PATH="var/telemetry-spool.sqlite3"
# Retention - both drop the oldest first. An unbounded spool fills the SD card,
# which takes the whole vehicle down. 0 disables either cap.
TELEMETRY_SPOOL_MAX_ROWS="10000"
TELEMETRY_SPOOL_MAX_AGE_DAYS="7"
# Spooled messages sent per flush before the loop sleeps again.
TELEMETRY_SPOOL_BATCH="50"

